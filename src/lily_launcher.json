                {
                    "name": "Notepad",
                    "icon": "notepad.png",
                    "command": "notepad.exe"
                },
                {
                    "name": "Calculator",
                    "icon": "calculator.png",
                    "command": "calc.exe"
                },
                {
                    "name": "Snipping tool",
                    "icon": "snipping_tool.png",
                    "command": "snippingtool.exe"
                }
            ]
        },
        {
            "name": "Folders",
            "icon": "folder.png",
            "items": [
                {
                    "name": "Personal",
                    "icon": "folder.png",
                    "items": [
                        {
                            "name": "My Documents",
                            "icon": "folder.png",
                            "command": "explorer.exe shell:Personal"
